# Database Credentials
DB_HOST=mysql-db
DB_PORT=3306

# To use sql script
DB_EXPOSED_HOST=127.0.0.1
DB_EXPOSED_PORT=3307

DB_USERNAME=emergency
DB_PASSWORD=<INSERISCI_PASSWORD_DB>
DB_ROOT_PASSWORD=<INSERISCI_PASSWORD_ROOT>

# JWT Settings
JWT_SECRET=<INSERISCI_SECRET_JWT_SICURO>
JWT_EXPIRATION=3600000

# CORS Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Internal Service URLs
REGISTRY_SERVICE_URL=http://registry-service:8081
BINDER_SERVICE_URL=http://orchestrator-binder-camunda:8082
ORCHESTRATOR_SERVICE_URL=http://orchestrator-binder-camunda:8083
EMERGENCY_SERVICE_URL=http://emergency-service:8084
OPERATOR_SERVICE_URL=http://operator-service:8087
AUTH_INTERNAL_URL=http://auth-service:8088
MOCK_SERVICE_URL=http://mock-service:8089

# Gateway URL
GATEWAY_URL=http://gateway-service:8090

# Specific Endpoints
BINDER_CANDIDATES_URL=http://orchestrator-binder-camunda:8082/api/binder/candidates
OPERATOR_ESCALATIONS_URL=http://operator-service:8087/api/operators/escalations
ESCALATION_WEBHOOK_URL=http://orchestrator-binder-camunda:8083/api/escalations

# Camunda 8
CAMUNDA_GRPC_ADDRESS=http://orchestrator-binder-camunda:26500
CAMUNDA_REST_ADDRESS=http://orchestrator-binder-camunda:8080

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
WORKFLOW_STORAGE_PATH=/app/bpmns/
