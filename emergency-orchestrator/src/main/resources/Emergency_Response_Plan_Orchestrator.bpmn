<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Emergency" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:message id="Message_Emergency_Report" name="Emergency_Report" />
  <bpmn:message id="Message_Firefighter_Response" name="Firefighter_Response" />
  <bpmn:message id="Message_Evacuation_Response" name="Evacuation_Response" />
  <bpmn:process id="Emergency_Response_Plan_Orchestrator" name="Emergency Response Plan Orchestrator" isExecutable="true">
    <bpmn:startEvent id="Start_Emergency_Report" name="Emergency Report">
      <bpmn:outgoing>Flow_Start_Analysis</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Emergency_Report" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Event_Analysis" name="Event Analysis">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="event-analysis" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Analysis</bpmn:incoming>
      <bpmn:outgoing>Flow_Analysis_Capability</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Plan_Selection" name="Plan Selection">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_Analysis_Capability</bpmn:incoming>
      <bpmn:outgoing>Flow_Flood_Plan</bpmn:outgoing>
      <bpmn:outgoing>Flow_City_Fire</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_ALS_Ambulance" name="Request ALS Ambulance">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;MedicalEmergency&#34;" target="requiredCapability" />
          <zeebe:input source="=coordinates.latitude" target="latitude" />
          <zeebe:input source="=coordinates.longitude" target="longitude" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1exb4cw</bpmn:incoming>
      <bpmn:outgoing>Flow_0q6lk1n</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_Flood_Plan" name="Flood" sourceRef="Gateway_Plan_Selection" targetRef="Call_Flood_Response">
      <bpmn:documentation>event.emergency_category = "FLOOD"</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=emergency_plan = "FLOOD"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="End_Emergency_Response" name="Emergency Response Completed">
      <bpmn:incoming>Flow_1l5tvwy</bpmn:incoming>
      <bpmn:incoming>Flow_1hmjz6t</bpmn:incoming>
      <bpmn:incoming>Flow_1ehizdk</bpmn:incoming>
      <bpmn:incoming>Flow_1mnkpqa</bpmn:incoming>
      <bpmn:incoming>Flow_1m9xjr1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Analysis" sourceRef="Start_Emergency_Report" targetRef="Task_Event_Analysis" />
    <bpmn:sequenceFlow id="Flow_Analysis_Capability" sourceRef="Task_Event_Analysis" targetRef="Gateway_Plan_Selection" />
    <bpmn:callActivity id="Call_Flood_Response" name="Flood Response">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FLOOD_RESPONSE&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Flood_Plan</bpmn:incoming>
      <bpmn:outgoing>Flow_1l5tvwy</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:inclusiveGateway id="Gateway_Emergency_Context" name="Emergency Context Flags">
      <bpmn:incoming>Flow_055sexm</bpmn:incoming>
      <bpmn:outgoing>Flow_0cfauu3</bpmn:outgoing>
      <bpmn:outgoing>Flow_trapper_people</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ehizdk</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:parallelGateway id="Gateway_1g5fgct">
      <bpmn:incoming>Flow_0cfauu3</bpmn:incoming>
      <bpmn:outgoing>Flow_1ry1z7s</bpmn:outgoing>
      <bpmn:outgoing>Flow_1exb4cw</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_1xp32nv">
      <bpmn:incoming>Flow_1j130t0</bpmn:incoming>
      <bpmn:incoming>Flow_0q6lk1n</bpmn:incoming>
      <bpmn:outgoing>Flow_1hmjz6t</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Task_Request_Evacuation" name="Ask For Evacuation" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Evacuation&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_trapper_people</bpmn:incoming>
      <bpmn:outgoing>Flow_0guodik</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_0cfauu3" name="Injured Peple" sourceRef="Gateway_Emergency_Context" targetRef="Gateway_1g5fgct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_injured</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_trapper_people" name="People in the building" sourceRef="Gateway_Emergency_Context" targetRef="Task_Request_Evacuation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ry1z7s" sourceRef="Gateway_1g5fgct" targetRef="Call_BLS_Ambulance" />
    <bpmn:sequenceFlow id="Flow_1exb4cw" sourceRef="Gateway_1g5fgct" targetRef="Call_ALS_Ambulance" />
    <bpmn:callActivity id="Call_BLS_Ambulance" name="Request BLS Ambulance">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;MedicalEmergency&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ry1z7s</bpmn:incoming>
      <bpmn:outgoing>Flow_1j130t0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1j130t0" sourceRef="Call_BLS_Ambulance" targetRef="Gateway_1xp32nv" />
    <bpmn:sequenceFlow id="Flow_0q6lk1n" sourceRef="Call_ALS_Ambulance" targetRef="Gateway_1xp32nv" />
    <bpmn:sequenceFlow id="Flow_1ehizdk" sourceRef="Gateway_Emergency_Context" targetRef="End_Emergency_Response" />
    <bpmn:callActivity id="Activity_Fire_Handling_Providers" name="Call fire handling providers" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FireSuppression&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18zitaf</bpmn:incoming>
      <bpmn:outgoing>Flow_00hpd0c</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="Gateway_1t52wen">
      <bpmn:incoming>Flow_City_Fire</bpmn:incoming>
      <bpmn:outgoing>Flow_18zitaf</bpmn:outgoing>
      <bpmn:outgoing>Flow_0oo3j48</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_1n38nz2">
      <bpmn:incoming>Flow_00hpd0c</bpmn:incoming>
      <bpmn:incoming>Flow_1eeeug8</bpmn:incoming>
      <bpmn:outgoing>Flow_055sexm</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Activity_Traffic_Delimitation" name="Ask for traffic delimitation" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CrowdControl&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oo3j48</bpmn:incoming>
      <bpmn:outgoing>Flow_1eeeug8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_18zitaf" sourceRef="Gateway_1t52wen" targetRef="Activity_Fire_Handling_Providers" />
    <bpmn:sequenceFlow id="Flow_00hpd0c" sourceRef="Activity_Fire_Handling_Providers" targetRef="Gateway_1n38nz2" />
    <bpmn:sequenceFlow id="Flow_0oo3j48" sourceRef="Gateway_1t52wen" targetRef="Activity_Traffic_Delimitation" />
    <bpmn:sequenceFlow id="Flow_1eeeug8" sourceRef="Activity_Traffic_Delimitation" targetRef="Gateway_1n38nz2" />
    <bpmn:sequenceFlow id="Flow_City_Fire" name="City Fire" sourceRef="Gateway_Plan_Selection" targetRef="Gateway_1t52wen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=emergency_plan = "FIRE_LOW"
or emergency_plan = "FIRE_STANDARD"
or emergency_plan = "FIRE_HIGH"
or emergency_plan = "FIRE_CRITICAL"
</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_055sexm" sourceRef="Gateway_1n38nz2" targetRef="Gateway_Emergency_Context" />
    <bpmn:sequenceFlow id="Flow_1l5tvwy" sourceRef="Call_Flood_Response" targetRef="End_Emergency_Response" />
    <bpmn:sequenceFlow id="Flow_1hmjz6t" sourceRef="Gateway_1xp32nv" targetRef="End_Emergency_Response" />
    <bpmn:serviceTask id="Activity_1cv18w6" name="Check If People Fully Evacuated">
      <bpmn:incoming>Flow_0i2g68c</bpmn:incoming>
      <bpmn:outgoing>Flow_0wart89</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1k5cnqn" name="People Fully Evacuated?">
      <bpmn:incoming>Flow_0wart89</bpmn:incoming>
      <bpmn:outgoing>Flow_0ib6a25</bpmn:outgoing>
      <bpmn:outgoing>Flow_1mnkpqa</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0tls8ar" name="Alert Firefighters for trapped people">
      <bpmn:incoming>Flow_0ib6a25</bpmn:incoming>
      <bpmn:outgoing>Flow_1m9xjr1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_1mjfqd7" name="Wait 15 Minutes">
      <bpmn:incoming>Flow_0guodik</bpmn:incoming>
      <bpmn:outgoing>Flow_0i2g68c</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0hh6pdj">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0i2g68c" sourceRef="Event_1mjfqd7" targetRef="Activity_1cv18w6" />
    <bpmn:sequenceFlow id="Flow_0wart89" sourceRef="Activity_1cv18w6" targetRef="Gateway_1k5cnqn" />
    <bpmn:sequenceFlow id="Flow_0ib6a25" name="Not Fully Evacuated" sourceRef="Gateway_1k5cnqn" targetRef="Activity_0tls8ar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${flowProgress.peopleEvacuated == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0guodik" sourceRef="Task_Request_Evacuation" targetRef="Event_1mjfqd7" />
    <bpmn:sequenceFlow id="Flow_1mnkpqa" sourceRef="Gateway_1k5cnqn" targetRef="End_Emergency_Response" />
    <bpmn:sequenceFlow id="Flow_1m9xjr1" sourceRef="Activity_0tls8ar" targetRef="End_Emergency_Response" />
    <bpmn:textAnnotation id="TextAnnotation_145kkxq">
      <bpmn:text>Qua questo è un esempio ma puoi togliere il gateway parallelo e far partire un TASK/Delegate che chiama il gestore workflow, scarica il BPMN adatto (siamo già su una condiziona valutata) e lo carica via codice su camunda</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1vcfbwk" associationDirection="None" sourceRef="Gateway_1t52wen" targetRef="TextAnnotation_145kkxq" />
    <bpmn:textAnnotation id="TextAnnotation_0m6rs9a">
      <bpmn:text>Chiama il BPMN binder e come input mapping (parametri che gli passo stile funzione) gli ho dato una capability hard coded in camunda perchè questo è come se fosse il BPMN caricato dal gestore workflow. Chi scrive il piano quindi può decidere le capability sulla base dei flag presenti nel JSON.
Prima passavo come input mapping anche latitudine e longitudine leggendole dal JSON ricevuto, ma a quanto pare il figlio eredita le varibili camunda del BPMN padre e le ho tolte.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0za0txh" associationDirection="None" sourceRef="Activity_Traffic_Delimitation" targetRef="TextAnnotation_0m6rs9a" />
    <bpmn:textAnnotation id="TextAnnotation_1o7zaug">
      <bpmn:text>Altro esempio di come l'esperto di dominio^TradeMark potrebbe sfurttare i flag</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1v3h2ml" associationDirection="None" sourceRef="Gateway_Emergency_Context" targetRef="TextAnnotation_1o7zaug" />
    <bpmn:textAnnotation id="TextAnnotation_1j63ipv">
      <bpmn:text>Anche qui la capability è hard coded e decisa dall'esperto di dominio sfruttando i flag disponibli</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ir5umd" associationDirection="None" sourceRef="Call_ALS_Ambulance" targetRef="TextAnnotation_1j63ipv" />
    <bpmn:textAnnotation id="TextAnnotation_1skfl33">
      <bpmn:text>Bisogna avvisare il gestore emergenze tramite task che l'emergenza è terminata oppure andando a sprecficare l'api/metadati di camunda</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1dhh0x2" associationDirection="None" sourceRef="End_Emergency_Response" targetRef="TextAnnotation_1skfl33" />
    <bpmn:textAnnotation id="TextAnnotation_0f3s0bi">
      <bpmn:text>Qua bisogna implementare un task di risposta. Uno stub che risponde sempre OK e camunda attende la risposta per poi andare avanti</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Emergency">
