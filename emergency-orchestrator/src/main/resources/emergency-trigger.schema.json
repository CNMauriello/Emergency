{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emergency Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "emergency_category",
    "severity",
    "incident_context",
    "coordinates",
    "address",
    "global_confidence"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "emergency_category": {
      "type": "string",
      "enum": [
        "FIRE",
        "FLOOD",
        "CAR_CRASH",
        "HEALTH_CRISIS",
        "UNKNOWN"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "incident_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_injured",
        "has_unconscious",
        "has_trapped",
        "has_special_vehicle_involved"
      ],
      "properties": {
        "has_injured": {
          "type": "boolean"
        },
        "has_unconscious": {
          "type": "boolean"
        },
        "has_trapped": {
          "type": "boolean"
        },
        "has_special_vehicle_involved": {
          "type": "boolean"
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "address": {
      "type": "string"
    },
    "global_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
