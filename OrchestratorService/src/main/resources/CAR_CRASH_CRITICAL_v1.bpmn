<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Emergency_Response_Plan" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:process id="CAR_CRASH_CRITICAL" name="Emergency Response Plan" isExecutable="true">
    <bpmn:startEvent id="Start_Emergency_Response_Plan" name="Start Emergency Response Plan">
      <bpmn:outgoing>Flow_Start_Emergency_Response_Plan</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_1t52wen">
      <bpmn:incoming>Flow_Start_Emergency_Response_Plan</bpmn:incoming>
      <bpmn:outgoing>Flow_18zitaf</bpmn:outgoing>
      <bpmn:outgoing>Flow_0oo3j48</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_18zitaf" sourceRef="Gateway_1t52wen" targetRef="Activity_Fire_Handling_Providers" />
    <bpmn:sequenceFlow id="Flow_0oo3j48" sourceRef="Gateway_1t52wen" targetRef="Activity_Traffic_Delimitation" />
    <bpmn:callActivity id="Activity_Fire_Handling_Providers" name="Call Police Intervention" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;PoliceIntervention&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18zitaf</bpmn:incoming>
      <bpmn:outgoing>Flow_1vz1n4q</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Activity_Traffic_Delimitation" name="Ask for traffic delimitation" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CrowdControl&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oo3j48</bpmn:incoming>
      <bpmn:outgoing>Flow_0sqkrun</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="Gateway_1n38nz2">
      <bpmn:incoming>Flow_1vz1n4q</bpmn:incoming>
      <bpmn:incoming>Flow_0sqkrun</bpmn:incoming>
      <bpmn:outgoing>Flow_055sexm</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_055sexm" sourceRef="Gateway_1n38nz2" targetRef="Gateway_Emergency_Context" />
    <bpmn:inclusiveGateway id="Gateway_Emergency_Context" name="Emergency Context Flags">
      <bpmn:incoming>Flow_055sexm</bpmn:incoming>
      <bpmn:outgoing>Flow_trapped</bpmn:outgoing>
      <bpmn:outgoing>Flow_injured_not_trapped</bpmn:outgoing>
      <bpmn:outgoing>Flow_safe</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="Flow_trapped" name="People trapped in vehicle" sourceRef="Gateway_Emergency_Context" targetRef="Activity_16xhkgl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_16xhkgl" name="Ask For Extrication">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={&#10;  method: &#34;GET&#34;,&#10;  url: &#34;http://gateway-service:8090/api/evacuation_service&#34;&#10;}" target="http" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_trapped</bpmn:incoming>
      <bpmn:outgoing>Flow_Extrication_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Extrication_Done" sourceRef="Activity_16xhkgl" targetRef="Gateway_Extrication_Parallel" />
    <bpmn:parallelGateway id="Gateway_Extrication_Parallel" name="Split Extrication Tasks">
      <bpmn:incoming>Flow_Extrication_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_Extr_to_Amb</bpmn:outgoing>
      <bpmn:outgoing>Flow_Extr_to_Wait</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_injured_not_trapped" name="Injured but not trapped" sourceRef="Gateway_Emergency_Context" targetRef="Gateway_Amb_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped = false and incident_context.has_injured</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_safe" name="No injuries or trapped" sourceRef="Gateway_Emergency_Context" targetRef="End_Emergency_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped = false and incident_context.has_injured = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_Amb_Merge" name="Merge Amb Requests">
      <bpmn:incoming>Flow_injured_not_trapped</bpmn:incoming>
      <bpmn:incoming>Flow_Extr_to_Amb</bpmn:incoming>
      <bpmn:outgoing>Flow_to_Amb_Split</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Extr_to_Amb" sourceRef="Gateway_Extrication_Parallel" targetRef="Gateway_Amb_Merge" />
    <bpmn:sequenceFlow id="Flow_to_Amb_Split" sourceRef="Gateway_Amb_Merge" targetRef="Gateway_1g5fgct" />
    <bpmn:parallelGateway id="Gateway_1g5fgct">
      <bpmn:incoming>Flow_to_Amb_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_1ry1z7s</bpmn:outgoing>
      <bpmn:outgoing>Flow_1exb4cw</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1ry1z7s" sourceRef="Gateway_1g5fgct" targetRef="Call_BLS_Ambulance" />
    <bpmn:sequenceFlow id="Flow_1exb4cw" sourceRef="Gateway_1g5fgct" targetRef="Call_ALS_Ambulance" />
    <bpmn:callActivity id="Call_BLS_Ambulance" name="Request BLS Ambulance">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Ambulance&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ry1z7s</bpmn:incoming>
      <bpmn:outgoing>Flow_1j130t0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_ALS_Ambulance" name="Request ALS Ambulance (Trauma)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;TraumaCare&#34;" target="requiredCapability" />
          <zeebe:input source="=coordinates.latitude" target="latitude" />
          <zeebe:input source="=coordinates.longitude" target="longitude" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1exb4cw</bpmn:incoming>
      <bpmn:outgoing>Flow_0q6lk1n</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1j130t0" sourceRef="Call_BLS_Ambulance" targetRef="Gateway_1xp32nv" />
    <bpmn:sequenceFlow id="Flow_0q6lk1n" sourceRef="Call_ALS_Ambulance" targetRef="Gateway_1xp32nv" />
    <bpmn:parallelGateway id="Gateway_1xp32nv">
      <bpmn:incoming>Flow_1j130t0</bpmn:incoming>
      <bpmn:incoming>Flow_0q6lk1n</bpmn:incoming>
      <bpmn:outgoing>Flow_Amb_to_End</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Amb_to_End" sourceRef="Gateway_1xp32nv" targetRef="End_Emergency_Response" />
    <bpmn:sequenceFlow id="Flow_Extr_to_Wait" sourceRef="Gateway_Extrication_Parallel" targetRef="Event_1mjfqd7" />
    <bpmn:intermediateCatchEvent id="Event_1mjfqd7" name="Wait 15 Minutes">
      <bpmn:incoming>Flow_Extr_to_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_0i2g68c</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0hh6pdj">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0i2g68c" sourceRef="Event_1mjfqd7" targetRef="check_evacuation" />
    <bpmn:serviceTask id="check_evacuation" name="Check If People Fully Extricated">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={&#10;  method: &#34;GET&#34;,&#10;  url: &#34;http://gateway-service:8090/api/evacuation_service&#34;&#10;}" target="http" />
          <zeebe:output source="=httpResponse.body.areExtricated" target="rExtricated" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0i2g68c</bpmn:incoming>
      <bpmn:outgoing>Flow_0wart89</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="check_evacuation_gateway" name="People Fully Extricated?" default="Flow_1w3p7bw">
      <bpmn:incoming>Flow_0wart89</bpmn:incoming>
      <bpmn:outgoing>Flow_Fully_Evcuated</bpmn:outgoing>
      <bpmn:outgoing>Flow_1w3p7bw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0wart89" sourceRef="check_evacuation" targetRef="check_evacuation_gateway" />
    <bpmn:sequenceFlow id="Flow_Fully_Evcuated" sourceRef="check_evacuation_gateway" targetRef="End_Emergency_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rExtricated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1w3p7bw" name="Not Fully Extricated" sourceRef="check_evacuation_gateway" targetRef="Activity_0gc36yu" />
    <bpmn:callActivity id="Activity_0gc36yu" name="Alert Rescue Team for extrication" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;SearchAndRescue&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1w3p7bw</bpmn:incoming>
      <bpmn:outgoing>Flow_13fp7m8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_13fp7m8" sourceRef="Activity_0gc36yu" targetRef="End_Emergency_Response" />
    <bpmn:endEvent id="End_Emergency_Response" name="Emergency Response Completed">
      <bpmn:incoming>Flow_safe</bpmn:incoming>
      <bpmn:incoming>Flow_Amb_to_End</bpmn:incoming>
      <bpmn:incoming>Flow_Fully_Evcuated</bpmn:incoming>
      <bpmn:incoming>Flow_13fp7m8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Emergency_Response_Plan" sourceRef="Start_Emergency_Response_Plan" targetRef="Gateway_1t52wen" />
    <bpmn:sequenceFlow id="Flow_1vz1n4q" sourceRef="Activity_Fire_Handling_Providers" targetRef="Gateway_1n38nz2" />
    <bpmn:sequenceFlow id="Flow_0sqkrun" sourceRef="Activity_Traffic_Delimitation" targetRef="Gateway_1n38nz2" />
  </bpmn:process>
