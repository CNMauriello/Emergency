<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Emergency" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:message id="Message_Emergency_Report" name="Emergency_Report" />
  <bpmn:message id="Message_Firefighter_Response" name="Firefighter_Response" />
  <bpmn:message id="Message_Evacuation_Response" name="Evacuation_Response" />
  <bpmn:process id="Emergency_Response_Plan_Orchestrator" name="Emergency Response Plan Orchestrator" isExecutable="true">
    <bpmn:serviceTask id="Task_Event_Analysis" name="Event Analysis">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="event-analysis" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Analysis</bpmn:incoming>
      <bpmn:outgoing>Flow_09pmp8p</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Plan_Selection" name="Plan Selection">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_18pkrii</bpmn:incoming>
      <bpmn:outgoing>Flow_Flood_Plan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Flood_Plan" sourceRef="Gateway_Plan_Selection" targetRef="Call_Fire_Response">
      <bpmn:documentation>event.emergency_category = "FLOOD"</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="End_Emergency_Response" name="Emergency Response Completed">
      <bpmn:incoming>Flow_0xyss1m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Analysis" sourceRef="Start_Emergency_Report" targetRef="Task_Event_Analysis" />
    <bpmn:callActivity id="Call_Fire_Response" name="Plan" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=emergency_plan" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Flood_Plan</bpmn:incoming>
      <bpmn:outgoing>Flow_11367i5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Activity_0t30rf7" name="Emergency closed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={&#10;  method: &#34;PATCH&#34;,&#10;  url: &#34;http://emergency-service:8084/api/emergencies/&#34; + string(event_id) + &#34;/status&#34;,&#10;  headers: {&#10;    &#34;Content-Type&#34;: &#34;application/json&#34;&#10;  },&#10;  body: {&#10;    status: &#34;CLOSED&#34;,&#10;    workflowInstanceId: string(processInstanceKey)&#10;  }&#10;}" target="http" />
          <zeebe:output source="=httpResponse.status = 200" target="updated" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ih3mpf</bpmn:incoming>
      <bpmn:incoming>Flow_1v592qz</bpmn:incoming>
      <bpmn:outgoing>Flow_0su7qkr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0su7qkr" name="status updated" sourceRef="Activity_0t30rf7" targetRef="Gateway_1lb5p3v" />
    <bpmn:exclusiveGateway id="Gateway_1lb5p3v" default="Flow_0xyss1m">
      <bpmn:incoming>Flow_0su7qkr</bpmn:incoming>
      <bpmn:outgoing>Flow_0xyss1m</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ih3mpf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0xyss1m" sourceRef="Gateway_1lb5p3v" targetRef="End_Emergency_Response" />
    <bpmn:sequenceFlow id="Flow_0ih3mpf" name="status not updated" sourceRef="Gateway_1lb5p3v" targetRef="Activity_0t30rf7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(updated)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:startEvent id="Start_Emergency_Report" name="Emergency Report">
      <bpmn:outgoing>Flow_Start_Analysis</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_1eor0pi" name="Managing of emergency">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={&#10;  method: &#34;PATCH&#34;,&#10;  url: &#34;http://emergency-service:8084/api/emergencies/&#34; + string(event_id) + &#34;/status&#34;,&#10;  headers: {&#10;    &#34;Content-Type&#34;: &#34;application/json&#34;&#10;  },&#10;  body: {&#10;    status: &#34;IN_PROGRESS&#34;,&#10;    workflowInstanceId: string(processInstanceKey)&#10;  }&#10;}" target="http" />
          <zeebe:output source="=httpResponse.status = 200" target="updated" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tz8in1</bpmn:incoming>
      <bpmn:incoming>Flow_09pmp8p</bpmn:incoming>
      <bpmn:outgoing>Flow_0akwxlk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1fny37z">
      <bpmn:incoming>Flow_0akwxlk</bpmn:incoming>
      <bpmn:outgoing>Flow_1tz8in1</bpmn:outgoing>
      <bpmn:outgoing>Flow_18pkrii</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1tz8in1" name="status not updated" sourceRef="Gateway_1fny37z" targetRef="Activity_1eor0pi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(updated)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09pmp8p" sourceRef="Task_Event_Analysis" targetRef="Activity_1eor0pi" />
    <bpmn:sequenceFlow id="Flow_18pkrii" sourceRef="Gateway_1fny37z" targetRef="Gateway_Plan_Selection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=updated</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0akwxlk" name="status updated" sourceRef="Activity_1eor0pi" targetRef="Gateway_1fny37z" />
    <bpmn:exclusiveGateway id="Gateway_1dl5w9f">
      <bpmn:incoming>Flow_11367i5</bpmn:incoming>
      <bpmn:outgoing>Flow_1v592qz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1v592qz" sourceRef="Gateway_1dl5w9f" targetRef="Activity_0t30rf7" />
    <bpmn:sequenceFlow id="Flow_11367i5" sourceRef="Call_Fire_Response" targetRef="Gateway_1dl5w9f" />
  </bpmn:process>
