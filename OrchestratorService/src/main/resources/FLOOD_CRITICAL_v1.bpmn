<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Flood_Response" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:process id="FLOOD_CRITICAL" name="Flood Emergency Response Plan" isExecutable="true">
    <bpmn:startEvent id="Start_Flood_Emergency" name="Start Flood Plan">
      <bpmn:outgoing>Flow_Start_To_Split1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Init_Split">
      <bpmn:incoming>Flow_Start_To_Split1</bpmn:incoming>
      <bpmn:outgoing>Flow_To_FloodResponse</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Communication</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Call_FloodResponse" name="Deploy Flood Response">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FloodResponse&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_FloodResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_FloodResponse_To_Join1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Communication" name="Emergency Communication">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;EmergencyCommunication&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Communication</bpmn:incoming>
      <bpmn:outgoing>Flow_Comm_To_Join1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="Gateway_Init_Join">
      <bpmn:incoming>Flow_FloodResponse_To_Join1</bpmn:incoming>
      <bpmn:incoming>Flow_Comm_To_Join1</bpmn:incoming>
      <bpmn:outgoing>Flow_Join1_To_Context</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:inclusiveGateway id="Gateway_Context_Split" name="Assess Flood Context" default="Flow_No_Additional_Action">
      <bpmn:incoming>Flow_Join1_To_Context</bpmn:incoming>
      <bpmn:outgoing>Flow_To_WaterRescue</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Medical</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Evacuation</bpmn:outgoing>
      <bpmn:outgoing>Flow_No_Additional_Action</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:callActivity id="Call_WaterRescue" name="Deploy Water Rescue">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;WaterRescue&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_WaterRescue</bpmn:incoming>
      <bpmn:outgoing>Flow_WaterRescue_To_Join2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Medical" name="Request Medical Emergency">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;MedicalEmergency&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Medical</bpmn:incoming>
      <bpmn:outgoing>Flow_Medical_To_Join2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Activity_16xhkgl" name="Ask For Evacuation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={&#10;  method: &#34;GET&#34;,&#10;  url: &#34;http://gateway-service:8090/api/evacuation_service&#34;&#10;}" target="http" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Evacuation</bpmn:incoming>
      <bpmn:outgoing>Flow_0guodik</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_1mjfqd7" name="Wait 15 Minutes">
      <bpmn:incoming>Flow_0guodik</bpmn:incoming>
      <bpmn:outgoing>Flow_0i2g68c</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0hh6pdj">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="check_evacuation" name="Check If People Fully Evacuated">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={&#10;  method: &#34;GET&#34;,&#10;  url: &#34;http://gateway-service:8090/api/evacuation_service&#34;&#10;}" target="http" />
          <zeebe:output source="=httpResponse.body.areEvacuated" target="rEvacuated" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0i2g68c</bpmn:incoming>
      <bpmn:outgoing>Flow_0wart89</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="check_evacuation_gateway" name="People Fully Evacuated?" default="Flow_1w3p7bw">
      <bpmn:incoming>Flow_0wart89</bpmn:incoming>
      <bpmn:outgoing>Flow_Fully_Evcuated</bpmn:outgoing>
      <bpmn:outgoing>Flow_1w3p7bw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_Helicopter_Rescue" name="Alert Helicopter Rescue" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;HelicopterRescue&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1w3p7bw</bpmn:incoming>
      <bpmn:outgoing>Flow_Helicopter_To_Join</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:inclusiveGateway id="Gateway_Context_Join">
      <bpmn:incoming>Flow_WaterRescue_To_Join2</bpmn:incoming>
      <bpmn:incoming>Flow_Medical_To_Join2</bpmn:incoming>
      <bpmn:incoming>Flow_Fully_Evcuated</bpmn:incoming>
      <bpmn:incoming>Flow_Helicopter_To_Join</bpmn:incoming>
      <bpmn:incoming>Flow_No_Additional_Action</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="End_Flood_Emergency" name="Flood Response Completed">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_Split1" sourceRef="Start_Flood_Emergency" targetRef="Gateway_Init_Split" />
    <bpmn:sequenceFlow id="Flow_To_FloodResponse" sourceRef="Gateway_Init_Split" targetRef="Call_FloodResponse" />
    <bpmn:sequenceFlow id="Flow_To_Communication" sourceRef="Gateway_Init_Split" targetRef="Call_Communication" />
    <bpmn:sequenceFlow id="Flow_FloodResponse_To_Join1" sourceRef="Call_FloodResponse" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_Comm_To_Join1" sourceRef="Call_Communication" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_Join1_To_Context" sourceRef="Gateway_Init_Join" targetRef="Gateway_Context_Split" />
    <bpmn:sequenceFlow id="Flow_To_WaterRescue" name="People Trapped in Water" sourceRef="Gateway_Context_Split" targetRef="Call_WaterRescue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_Medical" name="People Injured" sourceRef="Gateway_Context_Split" targetRef="Call_Medical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_injured = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_Evacuation" name="Evacuation Needed" sourceRef="Gateway_Context_Split" targetRef="Activity_16xhkgl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.needs_evacuation = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_No_Additional_Action" name="No extra action" sourceRef="Gateway_Context_Split" targetRef="Gateway_Context_Join" />
    <bpmn:sequenceFlow id="Flow_WaterRescue_To_Join2" sourceRef="Call_WaterRescue" targetRef="Gateway_Context_Join" />
    <bpmn:sequenceFlow id="Flow_Medical_To_Join2" sourceRef="Call_Medical" targetRef="Gateway_Context_Join" />
    <bpmn:sequenceFlow id="Flow_0guodik" sourceRef="Activity_16xhkgl" targetRef="Event_1mjfqd7" />
    <bpmn:sequenceFlow id="Flow_0i2g68c" sourceRef="Event_1mjfqd7" targetRef="check_evacuation" />
    <bpmn:sequenceFlow id="Flow_0wart89" sourceRef="check_evacuation" targetRef="check_evacuation_gateway" />
    <bpmn:sequenceFlow id="Flow_Fully_Evcuated" name="Evacuated" sourceRef="check_evacuation_gateway" targetRef="Gateway_Context_Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rEvacuated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1w3p7bw" name="Not Fully Evacuated" sourceRef="check_evacuation_gateway" targetRef="Call_Helicopter_Rescue" />
    <bpmn:sequenceFlow id="Flow_Helicopter_To_Join" sourceRef="Call_Helicopter_Rescue" targetRef="Gateway_Context_Join" />
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Gateway_Context_Join" targetRef="End_Flood_Emergency" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Flood_Response">
    <bpmndi:BPMNPlane id="BPMNPlane_Flood_Response" bpmnElement="FLOOD_CRITICAL_V3">
      <bpmndi:BPMNShape id="Start_Flood_Emergency_di" bpmnElement="Start_Flood_Emergency">
        <dc:Bounds x="150" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="131" y="275" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Init_Split_di" bpmnElement="Gateway_Init_Split">
