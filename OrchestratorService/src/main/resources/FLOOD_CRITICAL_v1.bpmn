      <bpmndi:BPMNShape id="Gateway_Init_Join_di" bpmnElement="Gateway_Init_Join">
        <dc:Bounds x="500" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Context_Split_di" bpmnElement="Gateway_Context_Split">
        <dc:Bounds x="600" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="641" y="296" width="39" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_16xhkgl_di" bpmnElement="Activity_16xhkgl">
        <dc:Bounds x="750" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1mjfqd7_di" bpmnElement="Event_1mjfqd7">
        <dc:Bounds x="900" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="879" y="405" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_evacuation_di" bpmnElement="check_evacuation">
        <dc:Bounds x="980" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_evacuation_gateway_di" bpmnElement="check_evacuation_gateway" isMarkerVisible="true">
        <dc:Bounds x="1150" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1114" y="330" width="122" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Context_Join_di" bpmnElement="Gateway_Context_Join">
        <dc:Bounds x="1450" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Flood_Emergency_di" bpmnElement="End_Flood_Emergency">
        <dc:Bounds x="1550" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1529" y="275" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Medical_di" bpmnElement="Call_Medical">
        <dc:Bounds x="868" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_WaterRescue_di" bpmnElement="Call_WaterRescue">
        <dc:Bounds x="868" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Helicopter_Rescue_di" bpmnElement="Call_Helicopter_Rescue">
        <dc:Bounds x="1300" y="450" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Split1_di" bpmnElement="Flow_Start_To_Split1">
        <di:waypoint x="186" y="250" />
        <di:waypoint x="250" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_FloodResponse_di" bpmnElement="Flow_To_FloodResponse">
        <di:waypoint x="275" y="225" />
        <di:waypoint x="275" y="140" />
        <di:waypoint x="350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Communication_di" bpmnElement="Flow_To_Communication">
        <di:waypoint x="275" y="275" />
        <di:waypoint x="275" y="360" />
        <di:waypoint x="350" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FloodResponse_To_Join1_di" bpmnElement="Flow_FloodResponse_To_Join1">
        <di:waypoint x="450" y="140" />
        <di:waypoint x="525" y="140" />
        <di:waypoint x="525" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Comm_To_Join1_di" bpmnElement="Flow_Comm_To_Join1">
        <di:waypoint x="450" y="360" />
        <di:waypoint x="525" y="360" />
        <di:waypoint x="525" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join1_To_Context_di" bpmnElement="Flow_Join1_To_Context">
        <di:waypoint x="550" y="250" />
        <di:waypoint x="600" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_WaterRescue_di" bpmnElement="Flow_To_WaterRescue">
        <di:waypoint x="625" y="225" />
        <di:waypoint x="625" y="120" />
        <di:waypoint x="868" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665" y="93" width="135" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Medical_di" bpmnElement="Flow_To_Medical">
        <di:waypoint x="650" y="250" />
        <di:waypoint x="868" y="250" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="725" y="223" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Evacuation_di" bpmnElement="Flow_To_Evacuation">
        <di:waypoint x="625" y="275" />
        <di:waypoint x="625" y="380" />
        <di:waypoint x="750" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="637" y="393" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_Additional_Action_di" bpmnElement="Flow_No_Additional_Action">
        <di:waypoint x="625" y="275" />
        <di:waypoint x="625" y="570" />
        <di:waypoint x="1475" y="570" />
        <di:waypoint x="1475" y="275" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1013" y="545" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_WaterRescue_To_Join2_di" bpmnElement="Flow_WaterRescue_To_Join2">
        <di:waypoint x="968" y="120" />
        <di:waypoint x="1475" y="120" />
        <di:waypoint x="1475" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Medical_To_Join2_di" bpmnElement="Flow_Medical_To_Join2">
        <di:waypoint x="968" y="250" />
        <di:waypoint x="1450" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0guodik_di" bpmnElement="Flow_0guodik">
        <di:waypoint x="850" y="380" />
        <di:waypoint x="900" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0i2g68c_di" bpmnElement="Flow_0i2g68c">
        <di:waypoint x="936" y="380" />
        <di:waypoint x="980" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0wart89_di" bpmnElement="Flow_0wart89">
        <di:waypoint x="1080" y="380" />
        <di:waypoint x="1150" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fully_Evcuated_di" bpmnElement="Flow_Fully_Evcuated">
        <di:waypoint x="1200" y="380" />
        <di:waypoint x="1475" y="380" />
        <di:waypoint x="1475" y="275" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1231" y="362" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
