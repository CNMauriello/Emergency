        <di:waypoint x="1175" y="405" />
        <di:waypoint x="1175" y="490" />
        <di:waypoint x="1300" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1209" y="446" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Helicopter_To_Join_di" bpmnElement="Flow_Helicopter_To_Join">
        <di:waypoint x="1400" y="490" />
        <di:waypoint x="1475" y="490" />
        <di:waypoint x="1475" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End">
        <di:waypoint x="1500" y="250" />
        <di:waypoint x="1550" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>