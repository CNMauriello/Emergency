<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Earthquake_High" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:process id="EARTHQUAKE_HIGH" name="Earthquake Response Plan (High)" isExecutable="true">
    
    <bpmn:startEvent id="Start_Earthquake_Plan" name="Start Earthquake Response Plan">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- INITIAL DISPATCH: 3-WAY PARALLEL SPLIT -->
    <bpmn:parallelGateway id="Gateway_Init_Split">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_To_DisasterResponse</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Fire</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Police</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- DISASTER RESPONSE -->
    <bpmn:callActivity id="Call_Disaster_Response" name="Activate Disaster Response">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;DisasterResponse&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_DisasterResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_From_DisasterResponse</bpmn:outgoing>
    </bpmn:callActivity>
    
    <!-- FIRE SUPPRESSION (Structural Checks & Fires) -->
    <bpmn:callActivity id="Call_FireSuppression" name="Deploy Fire Suppression">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FireSuppression&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Fire</bpmn:incoming>
      <bpmn:outgoing>Flow_From_Fire</bpmn:outgoing>
    </bpmn:callActivity>
    
    <!-- POLICE INTERVENTION -->
    <bpmn:callActivity id="Call_PoliceIntervention" name="Police Intervention &amp; Perimeters">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;PoliceIntervention&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Police</bpmn:incoming>
      <bpmn:outgoing>Flow_From_Police</bpmn:outgoing>
    </bpmn:callActivity>
    
    <!-- INITIAL JOIN -->
    <bpmn:parallelGateway id="Gateway_Init_Join">
      <bpmn:incoming>Flow_From_DisasterResponse</bpmn:incoming>
      <bpmn:incoming>Flow_From_Fire</bpmn:incoming>
      <bpmn:incoming>Flow_From_Police</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Context</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- INCLUSIVE CONTEXT GATEWAY -->
    <bpmn:inclusiveGateway id="Gateway_Emergency_Context" name="Emergency Context Flags">
      <bpmn:incoming>Flow_To_Context</bpmn:incoming>
      <bpmn:outgoing>Flow_Injured_People</bpmn:outgoing>
      <bpmn:outgoing>Flow_Trapped_People</bpmn:outgoing>
      <bpmn:outgoing>Flow_Safe</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    
    <!-- INJURED ROUTE -> AMBULANCE -->
    <bpmn:sequenceFlow id="Flow_Injured_People" name="Injured People" sourceRef="Gateway_Emergency_Context" targetRef="Call_Ambulance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_injured</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:callActivity id="Call_Ambulance" name="Request Ambulance">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Ambulance&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Injured_People</bpmn:incoming>
      <bpmn:outgoing>Flow_Ambulance_Done</bpmn:outgoing>
    </bpmn:callActivity>
    
    <!-- TRAPPED ROUTE (IMMEDIATE PARALLEL EVACUATION & SAR) -->
    <bpmn:sequenceFlow id="Flow_Trapped_People" name="People trapped under rubble" sourceRef="Gateway_Emergency_Context" targetRef="Gateway_Trapped_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:parallelGateway id="Gateway_Trapped_Split">
      <bpmn:incoming>Flow_Trapped_People</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Evacuation</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_SAR</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:callActivity id="Call_Evacuation" name="Execute Evacuation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Evacuation&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Evacuation</bpmn:incoming>
      <bpmn:outgoing>Flow_Evacuation_Done</bpmn:outgoing>
    </bpmn:callActivity>
    
    <bpmn:callActivity id="Call_SAR" name="Deploy Search &amp; Rescue (USAR)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;SearchAndRescue&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_SAR</bpmn:incoming>
      <bpmn:outgoing>Flow_SAR_Done</bpmn:outgoing>
    </bpmn:callActivity>
    
    <bpmn:parallelGateway id="Gateway_Trapped_Join">
      <bpmn:incoming>Flow_Evacuation_Done</bpmn:incoming>
      <bpmn:incoming>Flow_SAR_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_Trapped_Done</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- SAFE ROUTE -->
    <bpmn:sequenceFlow id="Flow_Safe" name="No injured or trapped" sourceRef="Gateway_Emergency_Context" targetRef="Gateway_Context_Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped = false and incident_context.has_injured = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <!-- CONTEXT JOIN -->
    <bpmn:inclusiveGateway id="Gateway_Context_Join">
      <bpmn:incoming>Flow_Ambulance_Done</bpmn:incoming>
      <bpmn:incoming>Flow_Trapped_Done</bpmn:incoming>
      <bpmn:incoming>Flow_Safe</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    
    <!-- END EVENT -->
    <bpmn:endEvent id="End_Emergency_Response" name="Earthquake Response Completed">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- BASIC FLOW CONNECTIONS -->
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Earthquake_Plan" targetRef="Gateway_Init_Split" />
    <bpmn:sequenceFlow id="Flow_To_DisasterResponse" sourceRef="Gateway_Init_Split" targetRef="Call_Disaster_Response" />
    <bpmn:sequenceFlow id="Flow_To_Fire" sourceRef="Gateway_Init_Split" targetRef="Call_FireSuppression" />
    <bpmn:sequenceFlow id="Flow_To_Police" sourceRef="Gateway_Init_Split" targetRef="Call_PoliceIntervention" />
    
    <bpmn:sequenceFlow id="Flow_From_DisasterResponse" sourceRef="Call_Disaster_Response" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_From_Fire" sourceRef="Call_FireSuppression" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_From_Police" sourceRef="Call_PoliceIntervention" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_To_Context" sourceRef="Gateway_Init_Join" targetRef="Gateway_Emergency_Context" />
    
    <bpmn:sequenceFlow id="Flow_Ambulance_Done" sourceRef="Call_Ambulance" targetRef="Gateway_Context_Join" />
    
    <bpmn:sequenceFlow id="Flow_To_Evacuation" sourceRef="Gateway_Trapped_Split" targetRef="Call_Evacuation" />
    <bpmn:sequenceFlow id="Flow_To_SAR" sourceRef="Gateway_Trapped_Split" targetRef="Call_SAR" />
    <bpmn:sequenceFlow id="Flow_Evacuation_Done" sourceRef="Call_Evacuation" targetRef="Gateway_Trapped_Join" />
    <bpmn:sequenceFlow id="Flow_SAR_Done" sourceRef="Call_SAR" targetRef="Gateway_Trapped_Join" />
    <bpmn:sequenceFlow id="Flow_Trapped_Done" sourceRef="Gateway_Trapped_Join" targetRef="Gateway_Context_Join" />
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Gateway_Context_Join" targetRef="End_Emergency_Response" />
    
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_Earthquake_High">
    <bpmndi:BPMNPlane id="BPMNPlane_Earthquake_High" bpmnElement="EARTHQUAKE_HIGH">
      <bpmndi:BPMNShape id="Start_Earthquake_Plan_di" bpmnElement="Start_Earthquake_Plan">
        <dc:Bounds x="150" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="127" y="425" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Init_Split_di" bpmnElement="Gateway_Init_Split">
        <dc:Bounds x="250" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Disaster_Response_di" bpmnElement="Call_Disaster_Response">
        <dc:Bounds x="350" y="250" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_FireSuppression_di" bpmnElement="Call_FireSuppression">
        <dc:Bounds x="350" y="360" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_PoliceIntervention_di" bpmnElement="Call_PoliceIntervention">
        <dc:Bounds x="350" y="470" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Init_Join_di" bpmnElement="Gateway_Init_Join">
        <dc:Bounds x="550" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Emergency_Context_di" bpmnElement="Gateway_Emergency_Context">
        <dc:Bounds x="650" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="566" y="380" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Ambulance_di" bpmnElement="Call_Ambulance">
        <dc:Bounds x="850" y="250" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Trapped_Split_di" bpmnElement="Gateway_Trapped_Split">
        <dc:Bounds x="780" y="595" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Evacuation_di" bpmnElement="Call_Evacuation">
        <dc:Bounds x="890" y="510" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SAR_di" bpmnElement="Call_SAR">
        <dc:Bounds x="890" y="640" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Trapped_Join_di" bpmnElement="Gateway_Trapped_Join">
        <dc:Bounds x="1100" y="595" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Context_Join_di" bpmnElement="Gateway_Context_Join">
        <dc:Bounds x="1250" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Emergency_Response_di" bpmnElement="End_Emergency_Response">
        <dc:Bounds x="1350" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1338" y="425" width="60" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- EDGES -->
      <bpmndi:BPMNEdge id="Flow_Start_di" bpmnElement="Flow_Start">
        <di:waypoint x="186" y="400" />
        <di:waypoint x="250" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_DisasterResponse_di" bpmnElement="Flow_To_DisasterResponse">
        <di:waypoint x="275" y="375" />
        <di:waypoint x="275" y="290" />
        <di:waypoint x="350" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Fire_di" bpmnElement="Flow_To_Fire">
        <di:waypoint x="300" y="400" />
        <di:waypoint x="350" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Police_di" bpmnElement="Flow_To_Police">
        <di:waypoint x="275" y="425" />
        <di:waypoint x="275" y="510" />
        <di:waypoint x="350" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_From_DisasterResponse_di" bpmnElement="Flow_From_DisasterResponse">
        <di:waypoint x="500" y="290" />
        <di:waypoint x="575" y="290" />
        <di:waypoint x="575" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_From_Fire_di" bpmnElement="Flow_From_Fire">
        <di:waypoint x="500" y="400" />
        <di:waypoint x="550" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_From_Police_di" bpmnElement="Flow_From_Police">
        <di:waypoint x="500" y="510" />
        <di:waypoint x="575" y="510" />
        <di:waypoint x="575" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Context_di" bpmnElement="Flow_To_Context">
        <di:waypoint x="600" y="400" />
        <di:waypoint x="650" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Injured_People_di" bpmnElement="Flow_Injured_People">
        <di:waypoint x="675" y="375" />
        <di:waypoint x="675" y="290" />
        <di:waypoint x="850" y="290" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="690" y="273" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ambulance_Done_di" bpmnElement="Flow_Ambulance_Done">
        <di:waypoint x="1000" y="290" />
        <di:waypoint x="1275" y="290" />
        <di:waypoint x="1275" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Trapped_People_di" bpmnElement="Flow_Trapped_People">
        <di:waypoint x="675" y="425" />
        <di:waypoint x="675" y="620" />
        <di:waypoint x="780" y="620" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="677" y="630" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Evacuation_di" bpmnElement="Flow_To_Evacuation">
        <di:waypoint x="805" y="595" />
        <di:waypoint x="805" y="550" />
        <di:waypoint x="890" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_SAR_di" bpmnElement="Flow_To_SAR">
        <di:waypoint x="805" y="645" />
        <di:waypoint x="805" y="680" />
        <di:waypoint x="890" y="680" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Evacuation_Done_di" bpmnElement="Flow_Evacuation_Done">
        <di:waypoint x="1040" y="550" />
        <di:waypoint x="1125" y="550" />
        <di:waypoint x="1125" y="595" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SAR_Done_di" bpmnElement="Flow_SAR_Done">
        <di:waypoint x="1040" y="680" />
        <di:waypoint x="1125" y="680" />
        <di:waypoint x="1125" y="645" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Trapped_Done_di" bpmnElement="Flow_Trapped_Done">
        <di:waypoint x="1150" y="620" />
        <di:waypoint x="1275" y="620" />
        <di:waypoint x="1275" y="425" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Safe_di" bpmnElement="Flow_Safe">
        <di:waypoint x="700" y="400" />
        <di:waypoint x="1250" y="400" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="950" y="382" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End">
        <di:waypoint x="1300" y="400" />
        <di:waypoint x="1350" y="400" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>