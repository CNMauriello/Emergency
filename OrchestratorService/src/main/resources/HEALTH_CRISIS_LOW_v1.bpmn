<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Health_Emergency_Low" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:process id="HEALTH_CRISIS_LOW" name="Health Emergency Plan (Low)" isExecutable="true">
    
    <bpmn:startEvent id="Start_Emergency_Response_Plan" name="Start Health Emergency">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- AMBULANCE ONLY FOR MINOR HEALTH CRISIS -->
    <bpmn:callActivity id="Call_Ambulance" name="Dispatch BLS (Ambulance)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Ambulance&#34;" target="requiredCapability" />
          <zeebe:input source="=coordinates.latitude" target="latitude" />
          <zeebe:input source="=coordinates.longitude" target="longitude" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Context</bpmn:outgoing>
    </bpmn:callActivity>
    
    <!-- INCIDENT CONTEXT GATEWAY (Exclusive for LOW) -->
    <bpmn:exclusiveGateway id="Gateway_Emergency_Context" name="Condition worsened?">
      <bpmn:incoming>Flow_To_Context</bpmn:incoming>
      <bpmn:outgoing>Flow_Worsened</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- WORSENED PATH -> MEDICAL EMERGENCY -->
    <bpmn:sequenceFlow id="Flow_Worsened" name="Yes (Escalation)" sourceRef="Gateway_Emergency_Context" targetRef="Call_MedicalEmergency">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_unconscious</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:callActivity id="Call_MedicalEmergency" name="Request Medical Team">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;MedicalEmergency&#34;" target="requiredCapability" />
          <zeebe:input source="=coordinates.latitude" target="latitude" />
          <zeebe:input source="=coordinates.longitude" target="longitude" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Worsened</bpmn:incoming>
      <bpmn:outgoing>Flow_Medical_End</bpmn:outgoing>
    </bpmn:callActivity>
    
    <!-- STABLE PATH -->
    <bpmn:sequenceFlow id="Flow_Stable" name="No (Stable)" sourceRef="Gateway_Emergency_Context" targetRef="End_Emergency_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_unconscious = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <!-- END EVENT -->
    <bpmn:endEvent id="End_Emergency_Response" name="Response Completed">
      <bpmn:incoming>Flow_Stable</bpmn:incoming>
      <bpmn:incoming>Flow_Medical_End</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- BASIC FLOWS -->
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Emergency_Response_Plan" targetRef="Call_Ambulance" />
    <bpmn:sequenceFlow id="Flow_To_Context" sourceRef="Call_Ambulance" targetRef="Gateway_Emergency_Context" />
    <bpmn:sequenceFlow id="Flow_Medical_End" sourceRef="Call_MedicalEmergency" targetRef="End_Emergency_Response" />
    
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_Health_Emergency_Low">
    <bpmndi:BPMNPlane id="BPMNPlane_Health_Emergency_Low" bpmnElement="HEALTH_CRISIS_LOW">
      <bpmndi:BPMNShape id="Start_Emergency_Response_Plan_di" bpmnElement="Start_Emergency_Response_Plan">
        <dc:Bounds x="170" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="159" y="295" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Ambulance_di" bpmnElement="Call_Ambulance">
        <dc:Bounds x="300" y="230" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Emergency_Context_di" bpmnElement="Gateway_Emergency_Context" isMarkerVisible="true">
        <dc:Bounds x="535" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="532" y="302" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_MedicalEmergency_di" bpmnElement="Call_MedicalEmergency">
        <dc:Bounds x="670" y="80" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Emergency_Response_di" bpmnElement="End_Emergency_Response">
        <dc:Bounds x="892" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="883" y="295" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_di" bpmnElement="Flow_Start">
        <di:waypoint x="206" y="270" />
        <di:waypoint x="300" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Context_di" bpmnElement="Flow_To_Context">
        <di:waypoint x="450" y="270" />
        <di:waypoint x="535" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Worsened_di" bpmnElement="Flow_Worsened">
        <di:waypoint x="560" y="245" />
        <di:waypoint x="560" y="120" />
        <di:waypoint x="670" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="180" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Stable_di" bpmnElement="Flow_Stable">
        <di:waypoint x="585" y="270" />
        <di:waypoint x="892" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="713" y="252" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Medical_End_di" bpmnElement="Flow_Medical_End">
        <di:waypoint x="820" y="120" />
        <di:waypoint x="910" y="120" />
        <di:waypoint x="910" y="252" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>