<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Flood_Response_High" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:process id="FLOOD_HIGH" name="Flood Emergency Response Plan (High)" isExecutable="true">
    <bpmn:startEvent id="Start_Flood_Emergency" name="Start Flood Plan">
      <bpmn:outgoing>Flow_Start_To_Split1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:parallelGateway id="Gateway_Init_Split">
      <bpmn:incoming>Flow_Start_To_Split1</bpmn:incoming>
      <bpmn:outgoing>Flow_To_FloodResponse</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Communication</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:callActivity id="Call_FloodResponse" name="Deploy Flood Response">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FloodResponse&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_FloodResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_FloodResponse_To_Join1</bpmn:outgoing>
    </bpmn:callActivity>
    
    <bpmn:callActivity id="Call_Communication" name="Emergency Communication">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;EmergencyCommunication&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Communication</bpmn:incoming>
      <bpmn:outgoing>Flow_Comm_To_Join1</bpmn:outgoing>
    </bpmn:callActivity>
    
    <bpmn:parallelGateway id="Gateway_Init_Join">
      <bpmn:incoming>Flow_FloodResponse_To_Join1</bpmn:incoming>
      <bpmn:incoming>Flow_Comm_To_Join1</bpmn:incoming>
      <bpmn:outgoing>Flow_Join1_To_Context</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- CONTEXT GATEWAY -->
    <bpmn:inclusiveGateway id="Gateway_Context_Split" name="Assess Flood Context" default="Flow_No_Additional_Action">
      <bpmn:incoming>Flow_Join1_To_Context</bpmn:incoming>
      <bpmn:outgoing>Flow_To_WaterRescue</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Ambulance</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Evacuation</bpmn:outgoing>
      <bpmn:outgoing>Flow_No_Additional_Action</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    
    <bpmn:callActivity id="Call_WaterRescue" name="Deploy Water Rescue">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;WaterRescue&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_WaterRescue</bpmn:incoming>
      <bpmn:outgoing>Flow_WaterRescue_To_Join2</bpmn:outgoing>
    </bpmn:callActivity>
    
    <bpmn:callActivity id="Call_Ambulance" name="Request Ambulance">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Ambulance&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Ambulance</bpmn:incoming>
      <bpmn:outgoing>Flow_Ambulance_To_Join2</bpmn:outgoing>
    </bpmn:callActivity>
    
    <bpmn:callActivity id="Call_Evacuation" name="Execute Evacuation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Evacuation&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Evacuation</bpmn:incoming>
      <bpmn:outgoing>Flow_Evacuation_To_Join2</bpmn:outgoing>
    </bpmn:callActivity>
    
    <!-- CONTEXT JOIN -->
    <bpmn:inclusiveGateway id="Gateway_Context_Join">
      <bpmn:incoming>Flow_WaterRescue_To_Join2</bpmn:incoming>
      <bpmn:incoming>Flow_Ambulance_To_Join2</bpmn:incoming>
      <bpmn:incoming>Flow_Evacuation_To_Join2</bpmn:incoming>
      <bpmn:incoming>Flow_No_Additional_Action</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    
    <bpmn:endEvent id="End_Flood_Emergency" name="Flood Response Completed">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- FLOWS -->
    <bpmn:sequenceFlow id="Flow_Start_To_Split1" sourceRef="Start_Flood_Emergency" targetRef="Gateway_Init_Split" />
    <bpmn:sequenceFlow id="Flow_To_FloodResponse" sourceRef="Gateway_Init_Split" targetRef="Call_FloodResponse" />
    <bpmn:sequenceFlow id="Flow_To_Communication" sourceRef="Gateway_Init_Split" targetRef="Call_Communication" />
    <bpmn:sequenceFlow id="Flow_FloodResponse_To_Join1" sourceRef="Call_FloodResponse" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_Comm_To_Join1" sourceRef="Call_Communication" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_Join1_To_Context" sourceRef="Gateway_Init_Join" targetRef="Gateway_Context_Split" />
    
    <bpmn:sequenceFlow id="Flow_To_WaterRescue" name="People Trapped in Water" sourceRef="Gateway_Context_Split" targetRef="Call_WaterRescue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_Ambulance" name="People Injured" sourceRef="Gateway_Context_Split" targetRef="Call_Ambulance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_injured = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_Evacuation" name="Evacuation Needed" sourceRef="Gateway_Context_Split" targetRef="Call_Evacuation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.needs_evacuation = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_No_Additional_Action" name="No extra action" sourceRef="Gateway_Context_Split" targetRef="Gateway_Context_Join" />
    
    <bpmn:sequenceFlow id="Flow_WaterRescue_To_Join2" sourceRef="Call_WaterRescue" targetRef="Gateway_Context_Join" />
    <bpmn:sequenceFlow id="Flow_Ambulance_To_Join2" sourceRef="Call_Ambulance" targetRef="Gateway_Context_Join" />
    <bpmn:sequenceFlow id="Flow_Evacuation_To_Join2" sourceRef="Call_Evacuation" targetRef="Gateway_Context_Join" />
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Gateway_Context_Join" targetRef="End_Flood_Emergency" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_Flood_Response_High">
    <bpmndi:BPMNPlane id="BPMNPlane_Flood_Response_High" bpmnElement="FLOOD_HIGH">
      <bpmndi:BPMNShape id="Start_Flood_Emergency_di" bpmnElement="Start_Flood_Emergency">
        <dc:Bounds x="150" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="131" y="275" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Init_Split_di" bpmnElement="Gateway_Init_Split">
        <dc:Bounds x="250" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_FloodResponse_di" bpmnElement="Call_FloodResponse">
        <dc:Bounds x="350" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Communication_di" bpmnElement="Call_Communication">
        <dc:Bounds x="350" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Init_Join_di" bpmnElement="Gateway_Init_Join">
        <dc:Bounds x="500" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Context_Split_di" bpmnElement="Gateway_Context_Split">
        <dc:Bounds x="600" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_WaterRescue_di" bpmnElement="Call_WaterRescue">
        <dc:Bounds x="868" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Ambulance_di" bpmnElement="Call_Ambulance">
        <dc:Bounds x="868" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Evacuation_di" bpmnElement="Call_Evacuation">
        <dc:Bounds x="868" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Context_Join_di" bpmnElement="Gateway_Context_Join">
        <dc:Bounds x="1150" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Flood_Emergency_di" bpmnElement="End_Flood_Emergency">
        <dc:Bounds x="1250" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_To_Split1_di" bpmnElement="Flow_Start_To_Split1">
        <di:waypoint x="186" y="250" />
        <di:waypoint x="250" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_FloodResponse_di" bpmnElement="Flow_To_FloodResponse">
        <di:waypoint x="275" y="225" />
        <di:waypoint x="275" y="140" />
        <di:waypoint x="350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Communication_di" bpmnElement="Flow_To_Communication">
        <di:waypoint x="275" y="275" />
        <di:waypoint x="275" y="360" />
        <di:waypoint x="350" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FloodResponse_To_Join1_di" bpmnElement="Flow_FloodResponse_To_Join1">
        <di:waypoint x="450" y="140" />
        <di:waypoint x="525" y="140" />
        <di:waypoint x="525" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Comm_To_Join1_di" bpmnElement="Flow_Comm_To_Join1">
        <di:waypoint x="450" y="360" />
        <di:waypoint x="525" y="360" />
        <di:waypoint x="525" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join1_To_Context_di" bpmnElement="Flow_Join1_To_Context">
        <di:waypoint x="550" y="250" />
        <di:waypoint x="600" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_WaterRescue_di" bpmnElement="Flow_To_WaterRescue">
        <di:waypoint x="625" y="225" />
        <di:waypoint x="625" y="120" />
        <di:waypoint x="868" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Ambulance_di" bpmnElement="Flow_To_Ambulance">
        <di:waypoint x="650" y="250" />
        <di:waypoint x="868" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Evacuation_di" bpmnElement="Flow_To_Evacuation">
        <di:waypoint x="625" y="275" />
        <di:waypoint x="625" y="380" />
        <di:waypoint x="868" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_Additional_Action_di" bpmnElement="Flow_No_Additional_Action">
        <di:waypoint x="625" y="275" />
        <di:waypoint x="625" y="470" />
        <di:waypoint x="1175" y="470" />
        <di:waypoint x="1175" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_WaterRescue_To_Join2_di" bpmnElement="Flow_WaterRescue_To_Join2">
        <di:waypoint x="968" y="120" />
        <di:waypoint x="1175" y="120" />
        <di:waypoint x="1175" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ambulance_To_Join2_di" bpmnElement="Flow_Ambulance_To_Join2">
        <di:waypoint x="968" y="250" />
        <di:waypoint x="1150" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Evacuation_To_Join2_di" bpmnElement="Flow_Evacuation_To_Join2">
        <di:waypoint x="968" y="380" />
        <di:waypoint x="1175" y="380" />
        <di:waypoint x="1175" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End">
        <di:waypoint x="1200" y="250" />
        <di:waypoint x="1250" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>