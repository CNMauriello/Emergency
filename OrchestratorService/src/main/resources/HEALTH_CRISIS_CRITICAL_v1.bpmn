<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Health_Emergency" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:process id="HEALTH_CRISIS_CRITICAL" name="Health Emergency Plan" isExecutable="true">
    <bpmn:startEvent id="Start_Emergency_Response_Plan" name="Start Health Emergency">
      <bpmn:outgoing>Flow_Start_To_Split</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Start_Parallel">
      <bpmn:incoming>Flow_Start_To_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Comms</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Crowd</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Start_To_Split" sourceRef="Start_Emergency_Response_Plan" targetRef="Gateway_Start_Parallel" />
    <bpmn:callActivity id="Activity_Emergency_Comms" name="Start Emergency Comms (First Aid)" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;EmergencyCommunication&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Comms</bpmn:incoming>
      <bpmn:outgoing>Flow_Comms_To_Merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Activity_Crowd_Control" name="Ask for crowd control" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CrowdControl&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Crowd</bpmn:incoming>
      <bpmn:outgoing>Flow_Crowd_To_Merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_To_Comms" sourceRef="Gateway_Start_Parallel" targetRef="Activity_Emergency_Comms" />
    <bpmn:sequenceFlow id="Flow_To_Crowd" sourceRef="Gateway_Start_Parallel" targetRef="Activity_Crowd_Control" />
    <bpmn:parallelGateway id="Gateway_Init_Merge">
      <bpmn:incoming>Flow_Comms_To_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Crowd_To_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Context</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Comms_To_Merge" sourceRef="Activity_Emergency_Comms" targetRef="Gateway_Init_Merge" />
    <bpmn:sequenceFlow id="Flow_Crowd_To_Merge" sourceRef="Activity_Crowd_Control" targetRef="Gateway_Init_Merge" />
    <bpmn:sequenceFlow id="Flow_To_Context" sourceRef="Gateway_Init_Merge" targetRef="Gateway_Health_Context" />
    <bpmn:exclusiveGateway id="Gateway_Health_Context" name="Patient Status">
      <bpmn:incoming>Flow_To_Context</bpmn:incoming>
      <bpmn:outgoing>Flow_Unconscious</bpmn:outgoing>
      <bpmn:outgoing>Flow_Injured</bpmn:outgoing>
      <bpmn:outgoing>Flow_Safe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Unconscious" name="Unconscious (Critical)" sourceRef="Gateway_Health_Context" targetRef="Call_ALS_Ambulance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_unconscious = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Injured" name="Injured / Conscious" sourceRef="Gateway_Health_Context" targetRef="Call_BLS_Ambulance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_unconscious = false and incident_context.has_injured = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Safe" name="No medical need" sourceRef="Gateway_Health_Context" targetRef="End_Emergency_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_unconscious = false and incident_context.has_injured = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="Call_ALS_Ambulance" name="Dispatch ALS (Trauma Care)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;TraumaCare&#34;" target="requiredCapability" />
          <zeebe:input source="=coordinates.latitude" target="latitude" />
          <zeebe:input source="=coordinates.longitude" target="longitude" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Unconscious</bpmn:incoming>
      <bpmn:outgoing>Flow_ALS_To_Merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_BLS_Ambulance" name="Dispatch BLS (Ambulance)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Ambulance&#34;" target="requiredCapability" />
          <zeebe:input source="=coordinates.latitude" target="latitude" />
          <zeebe:input source="=coordinates.longitude" target="longitude" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Injured</bpmn:incoming>
      <bpmn:outgoing>Flow_BLS_To_Merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_Amb_Merge">
      <bpmn:incoming>Flow_ALS_To_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_BLS_To_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ALS_To_Merge" sourceRef="Call_ALS_Ambulance" targetRef="Gateway_Amb_Merge" />
    <bpmn:sequenceFlow id="Flow_BLS_To_Merge" sourceRef="Call_BLS_Ambulance" targetRef="Gateway_Amb_Merge" />
    <bpmn:sequenceFlow id="Flow_To_Wait" sourceRef="Gateway_Amb_Merge" targetRef="Event_Wait_For_Medics" />
    <bpmn:intermediateCatchEvent id="Event_Wait_For_Medics" name="Wait 10 Minutes">
      <bpmn:incoming>Flow_To_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_To_Check</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Wait">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_Wait_To_Check" sourceRef="Event_Wait_For_Medics" targetRef="check_stabilization" />
    <bpmn:serviceTask id="check_stabilization" name="Check If Patient Stabilized" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="http://localhost:8090/api/health_service" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="18" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="rStabilized" />
          <zeebe:header key="resultExpression" value="={&#10;rStabilized:response.body.isStabilized&#10;}&#10;" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Wait_To_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Check_To_Gateway" sourceRef="check_stabilization" targetRef="Gateway_Stabilized" />
    <bpmn:exclusiveGateway id="Gateway_Stabilized" name="Patient Stabilized?" default="Flow_Not_Stabilized">
      <bpmn:incoming>Flow_Check_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Stabilized</bpmn:outgoing>
      <bpmn:outgoing>Flow_Not_Stabilized</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Stabilized" name="Yes" sourceRef="Gateway_Stabilized" targetRef="End_Emergency_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rStabilized = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Not_Stabilized" name="No (Critical Escalation)" sourceRef="Gateway_Stabilized" targetRef="Activity_Call_Helicopter" />
    <bpmn:callActivity id="Activity_Call_Helicopter" name="Request Helicopter Rescue" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;HelicopterRescue&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Not_Stabilized</bpmn:incoming>
      <bpmn:outgoing>Flow_Heli_To_End</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_Heli_To_End" sourceRef="Activity_Call_Helicopter" targetRef="End_Emergency_Response" />
    <bpmn:endEvent id="End_Emergency_Response" name="Response Completed">
      <bpmn:incoming>Flow_Safe</bpmn:incoming>
      <bpmn:incoming>Flow_Stabilized</bpmn:incoming>
      <bpmn:incoming>Flow_Heli_To_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Health_Emergency">
    <bpmndi:BPMNPlane id="BPMNPlane_Health_Emergency" bpmnElement="HEALTH_CRITICAL">
      <bpmndi:BPMNShape id="Start_Emergency_Response_Plan_di" bpmnElement="Start_Emergency_Response_Plan">
        <dc:Bounds x="150" y="280" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="139" y="323" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Start_Parallel_di" bpmnElement="Gateway_Start_Parallel" isMarkerVisible="true">
        <dc:Bounds x="250" y="273" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Emergency_Comms_di" bpmnElement="Activity_Emergency_Comms">
        <dc:Bounds x="350" y="170" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Crowd_Control_di" bpmnElement="Activity_Crowd_Control">
        <dc:Bounds x="350" y="360" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Init_Merge_di" bpmnElement="Gateway_Init_Merge" isMarkerVisible="true">
        <dc:Bounds x="550" y="273" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Stabilized_di" bpmnElement="Gateway_Stabilized" isMarkerVisible="true">
        <dc:Bounds x="1400" y="273" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1398" y="243" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Call_Helicopter_di" bpmnElement="Activity_Call_Helicopter">
        <dc:Bounds x="1500" y="360" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Emergency_Response_di" bpmnElement="End_Emergency_Response">
        <dc:Bounds x="1700" y="280" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1746" y="284" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_ALS_Ambulance_di" bpmnElement="Call_ALS_Ambulance">
        <dc:Bounds x="845" y="170" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_BLS_Ambulance_di" bpmnElement="Call_BLS_Ambulance">
        <dc:Bounds x="855" y="360" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_stabilization_di" bpmnElement="check_stabilization">
        <dc:Bounds x="1205" y="258" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Wait_For_Medics_di" bpmnElement="Event_Wait_For_Medics">
        <dc:Bounds x="1132" y="280" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1111" y="323" width="79" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Amb_Merge_di" bpmnElement="Gateway_Amb_Merge" isMarkerVisible="true">
        <dc:Bounds x="1045" y="273" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Health_Context_di" bpmnElement="Gateway_Health_Context" isMarkerVisible="true">
        <dc:Bounds x="675" y="273" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="735" y="291" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Split_di" bpmnElement="Flow_Start_To_Split">
        <di:waypoint x="186" y="298" />
        <di:waypoint x="250" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Comms_di" bpmnElement="Flow_To_Comms">
        <di:waypoint x="275" y="273" />
        <di:waypoint x="275" y="210" />
        <di:waypoint x="350" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Crowd_di" bpmnElement="Flow_To_Crowd">
        <di:waypoint x="275" y="323" />
        <di:waypoint x="275" y="400" />
        <di:waypoint x="350" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Comms_To_Merge_di" bpmnElement="Flow_Comms_To_Merge">
        <di:waypoint x="500" y="210" />
        <di:waypoint x="575" y="210" />
        <di:waypoint x="575" y="273" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Crowd_To_Merge_di" bpmnElement="Flow_Crowd_To_Merge">
        <di:waypoint x="500" y="400" />
        <di:waypoint x="575" y="400" />
        <di:waypoint x="575" y="323" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Context_di" bpmnElement="Flow_To_Context">
        <di:waypoint x="600" y="298" />
        <di:waypoint x="675" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Unconscious_di" bpmnElement="Flow_Unconscious">
        <di:waypoint x="700" y="273" />
        <di:waypoint x="700" y="210" />
        <di:waypoint x="845" y="210" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="713" y="176" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Injured_di" bpmnElement="Flow_Injured">
        <di:waypoint x="700" y="323" />
        <di:waypoint x="700" y="400" />
        <di:waypoint x="855" y="400" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="714" y="406" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Safe_di" bpmnElement="Flow_Safe">
        <di:waypoint x="700" y="273" />
        <di:waypoint x="700" y="100" />
        <di:waypoint x="1718" y="100" />
        <di:waypoint x="1718" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1167" y="75" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ALS_To_Merge_di" bpmnElement="Flow_ALS_To_Merge">
        <di:waypoint x="995" y="210" />
        <di:waypoint x="1070" y="210" />
        <di:waypoint x="1070" y="273" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BLS_To_Merge_di" bpmnElement="Flow_BLS_To_Merge">
        <di:waypoint x="1005" y="400" />
        <di:waypoint x="1070" y="400" />
        <di:waypoint x="1070" y="323" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Wait_di" bpmnElement="Flow_To_Wait">
        <di:waypoint x="1095" y="298" />
        <di:waypoint x="1132" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Wait_To_Check_di" bpmnElement="Flow_Wait_To_Check">
        <di:waypoint x="1168" y="298" />
        <di:waypoint x="1205" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_To_Gateway_di" bpmnElement="Flow_Check_To_Gateway">
        <di:waypoint x="1355" y="298" />
        <di:waypoint x="1400" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Stabilized_di" bpmnElement="Flow_Stabilized">
        <di:waypoint x="1450" y="298" />
        <di:waypoint x="1700" y="298" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1566" y="273" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Not_Stabilized_di" bpmnElement="Flow_Not_Stabilized">
        <di:waypoint x="1425" y="323" />
        <di:waypoint x="1425" y="400" />
        <di:waypoint x="1500" y="400" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1404" y="406" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Heli_To_End_di" bpmnElement="Flow_Heli_To_End">
        <di:waypoint x="1650" y="400" />
        <di:waypoint x="1718" y="400" />
        <di:waypoint x="1718" y="316" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
