<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Emergency_Response_Plan" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:process id="FIRE_CRITICAL" name="Emergency Response Plan" isExecutable="true">
    <bpmn:startEvent id="Start_Emergency_Response_Plan" name="Start Emergency Response Plan">
      <bpmn:outgoing>Flow_Start_Emergency_Response_Plan</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Call_ALS_Ambulance" name="Request ALS Ambulance">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;MedicalEmergency&#34;" target="requiredCapability" />
          <zeebe:input source="=coordinates.latitude" target="latitude" />
          <zeebe:input source="=coordinates.longitude" target="longitude" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1exb4cw</bpmn:incoming>
      <bpmn:outgoing>Flow_0q6lk1n</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:inclusiveGateway id="Gateway_Emergency_Context" name="Emergency Context Flags">
      <bpmn:incoming>Flow_055sexm</bpmn:incoming>
      <bpmn:outgoing>Flow_Injured_People</bpmn:outgoing>
      <bpmn:outgoing>Flow_trapped_people</bpmn:outgoing>
      <bpmn:outgoing>Flow_Injured_Or_Trapped</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:parallelGateway id="Gateway_1g5fgct">
      <bpmn:incoming>Flow_Injured_People</bpmn:incoming>
      <bpmn:outgoing>Flow_1ry1z7s</bpmn:outgoing>
      <bpmn:outgoing>Flow_1exb4cw</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_1xp32nv">
      <bpmn:incoming>Flow_1j130t0</bpmn:incoming>
      <bpmn:incoming>Flow_0q6lk1n</bpmn:incoming>
      <bpmn:outgoing>Flow_1rqbiwb</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Injured_People" name="Injured Peple" sourceRef="Gateway_Emergency_Context" targetRef="Gateway_1g5fgct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_injured</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_trapped_people" name="People in the building" sourceRef="Gateway_Emergency_Context" targetRef="Activity_16xhkgl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ry1z7s" sourceRef="Gateway_1g5fgct" targetRef="Call_BLS_Ambulance" />
    <bpmn:sequenceFlow id="Flow_1exb4cw" sourceRef="Gateway_1g5fgct" targetRef="Call_ALS_Ambulance" />
    <bpmn:callActivity id="Call_BLS_Ambulance" name="Request BLS Ambulance">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;MedicalEmergency&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ry1z7s</bpmn:incoming>
      <bpmn:outgoing>Flow_1j130t0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1j130t0" sourceRef="Call_BLS_Ambulance" targetRef="Gateway_1xp32nv" />
    <bpmn:sequenceFlow id="Flow_0q6lk1n" sourceRef="Call_ALS_Ambulance" targetRef="Gateway_1xp32nv" />
    <bpmn:sequenceFlow id="Flow_Injured_Or_Trapped" name="No injured or trapped" sourceRef="Gateway_Emergency_Context" targetRef="End_Emergency_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_trapped = false
and incident_context.has_injured = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="Activity_Fire_Handling_Providers" name="Call fire handling providers" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FireSuppression&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18zitaf</bpmn:incoming>
      <bpmn:outgoing>Flow_00hpd0c</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="Gateway_1t52wen">
      <bpmn:incoming>Flow_Start_Emergency_Response_Plan</bpmn:incoming>
      <bpmn:outgoing>Flow_18zitaf</bpmn:outgoing>
      <bpmn:outgoing>Flow_0oo3j48</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_1n38nz2">
      <bpmn:incoming>Flow_00hpd0c</bpmn:incoming>
      <bpmn:incoming>Flow_1eeeug8</bpmn:incoming>
      <bpmn:outgoing>Flow_055sexm</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Activity_Traffic_Delimitation" name="Ask for traffic delimitation" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CrowdControl&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oo3j48</bpmn:incoming>
      <bpmn:outgoing>Flow_1eeeug8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_18zitaf" sourceRef="Gateway_1t52wen" targetRef="Activity_Fire_Handling_Providers" />
    <bpmn:sequenceFlow id="Flow_00hpd0c" sourceRef="Activity_Fire_Handling_Providers" targetRef="Gateway_1n38nz2" />
    <bpmn:sequenceFlow id="Flow_1eeeug8" sourceRef="Activity_Traffic_Delimitation" targetRef="Gateway_1n38nz2" />
    <bpmn:sequenceFlow id="Flow_055sexm" sourceRef="Gateway_1n38nz2" targetRef="Gateway_Emergency_Context" />
    <bpmn:serviceTask id="check_evacuation" name="Check If People Fully Evacuated">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={&#10;  method: &#34;GET&#34;,&#10;  url: &#34;http://gateway-service:8090/api/evacuation_service&#34;&#10;}" target="http" />
          <zeebe:output source="=httpResponse.body.areEvacuated" target="rEvacuated" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0i2g68c</bpmn:incoming>
      <bpmn:outgoing>Flow_0wart89</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="check_evacuation_gateway" name="People Fully Evacuated?" default="Flow_1w3p7bw">
      <bpmn:incoming>Flow_0wart89</bpmn:incoming>
      <bpmn:outgoing>Flow_Fully_Evcuated</bpmn:outgoing>
      <bpmn:outgoing>Flow_1w3p7bw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_1mjfqd7" name="Wait 15 Minutes">
      <bpmn:incoming>Flow_0guodik</bpmn:incoming>
      <bpmn:outgoing>Flow_0i2g68c</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0hh6pdj">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0i2g68c" sourceRef="Event_1mjfqd7" targetRef="check_evacuation" />
    <bpmn:sequenceFlow id="Flow_0wart89" sourceRef="check_evacuation" targetRef="check_evacuation_gateway" />
    <bpmn:sequenceFlow id="Flow_0guodik" sourceRef="Activity_16xhkgl" targetRef="Event_1mjfqd7" />
    <bpmn:sequenceFlow id="Flow_Fully_Evcuated" sourceRef="check_evacuation_gateway" targetRef="End_Emergency_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rEvacuated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="Activity_0gc36yu" name="Alert Firefighters for trapped people" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;SearchAndRescue&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1w3p7bw</bpmn:incoming>
      <bpmn:outgoing>Flow_13fp7m8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_13fp7m8" sourceRef="Activity_0gc36yu" targetRef="End_Emergency_Response" />
    <bpmn:serviceTask id="Activity_16xhkgl" name="Ask For Evacuation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="http-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={&#10;  method: &#34;GET&#34;,&#10;  url: &#34;http://gateway-service:8090/api/evacuation_service&#34;&#10;}" target="http" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_trapped_people</bpmn:incoming>
      <bpmn:outgoing>Flow_0guodik</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Emergency_Response" name="Emergency Response Completed">
      <bpmn:incoming>Flow_Injured_Or_Trapped</bpmn:incoming>
      <bpmn:incoming>Flow_Fully_Evcuated</bpmn:incoming>
      <bpmn:incoming>Flow_13fp7m8</bpmn:incoming>
      <bpmn:incoming>Flow_1rqbiwb</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Emergency_Response_Plan" sourceRef="Start_Emergency_Response_Plan" targetRef="Gateway_1t52wen" />
    <bpmn:sequenceFlow id="Flow_1w3p7bw" name="Not Fully Evacuated" sourceRef="check_evacuation_gateway" targetRef="Activity_0gc36yu" />
    <bpmn:sequenceFlow id="Flow_1rqbiwb" sourceRef="Gateway_1xp32nv" targetRef="End_Emergency_Response" />
    <bpmn:sequenceFlow id="Flow_0oo3j48" sourceRef="Gateway_1t52wen" targetRef="Activity_Traffic_Delimitation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Emergency_Response_Plan">
