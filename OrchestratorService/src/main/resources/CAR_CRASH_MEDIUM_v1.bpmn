<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Car_Crash_Medium" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:process id="CAR_CRASH_MEDIUM" name="Emergency Response Plan (Medium)" isExecutable="true">
    
    <bpmn:startEvent id="Start_Emergency_Response_Plan" name="Start Emergency Response">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    
    <!-- INITIAL DISPATCH: POLICE & FIRE -->
    <bpmn:parallelGateway id="Gateway_Init_Split">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Police</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Fire</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <bpmn:callActivity id="Call_PoliceIntervention" name="Call Police Intervention">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;PoliceIntervention&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Police</bpmn:incoming>
      <bpmn:outgoing>Flow_From_Police</bpmn:outgoing>
    </bpmn:callActivity>
    
    <bpmn:callActivity id="Call_FireSuppression" name="Call Fire Suppression">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FireSuppression&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Fire</bpmn:incoming>
      <bpmn:outgoing>Flow_From_Fire</bpmn:outgoing>
    </bpmn:callActivity>
    
    <bpmn:parallelGateway id="Gateway_Init_Join">
      <bpmn:incoming>Flow_From_Police</bpmn:incoming>
      <bpmn:incoming>Flow_From_Fire</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Context</bpmn:outgoing>
    </bpmn:parallelGateway>
    
    <!-- EXCLUSIVE CONTEXT GATEWAY FOR INJURIES -->
    <bpmn:exclusiveGateway id="Gateway_Emergency_Context" name="Any injuries?">
      <bpmn:incoming>Flow_To_Context</bpmn:incoming>
      <bpmn:outgoing>Flow_Injured</bpmn:outgoing>
      <bpmn:outgoing>Flow_Safe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- INJURED PATH -> AMBULANCE -->
    <bpmn:sequenceFlow id="Flow_Injured" name="Injured People" sourceRef="Gateway_Emergency_Context" targetRef="Call_Ambulance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_injured</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:callActivity id="Call_Ambulance" name="Request Ambulance">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Ambulance&#34;" target="requiredCapability" />
          <zeebe:input source="=coordinates.latitude" target="latitude" />
          <zeebe:input source="=coordinates.longitude" target="longitude" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Injured</bpmn:incoming>
      <bpmn:outgoing>Flow_From_Ambulance</bpmn:outgoing>
    </bpmn:callActivity>
    
    <!-- NO INJURED PATH -->
    <bpmn:sequenceFlow id="Flow_Safe" name="No injuries" sourceRef="Gateway_Emergency_Context" targetRef="End_Emergency_Response">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incident_context.has_injured = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:endEvent id="End_Emergency_Response" name="Emergency Response Completed">
      <bpmn:incoming>Flow_Safe</bpmn:incoming>
      <bpmn:incoming>Flow_From_Ambulance</bpmn:incoming>
    </bpmn:endEvent>
    
    <!-- BASIC SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Emergency_Response_Plan" targetRef="Gateway_Init_Split" />
    <bpmn:sequenceFlow id="Flow_To_Police" sourceRef="Gateway_Init_Split" targetRef="Call_PoliceIntervention" />
    <bpmn:sequenceFlow id="Flow_To_Fire" sourceRef="Gateway_Init_Split" targetRef="Call_FireSuppression" />
    <bpmn:sequenceFlow id="Flow_From_Police" sourceRef="Call_PoliceIntervention" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_From_Fire" sourceRef="Call_FireSuppression" targetRef="Gateway_Init_Join" />
    <bpmn:sequenceFlow id="Flow_To_Context" sourceRef="Gateway_Init_Join" targetRef="Gateway_Emergency_Context" />
    <bpmn:sequenceFlow id="Flow_From_Ambulance" sourceRef="Call_Ambulance" targetRef="End_Emergency_Response" />
    
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_Emergency_Response_Plan_Medium">
    <bpmndi:BPMNPlane id="BPMNPlane_Emergency_Response_Plan_Medium" bpmnElement="CAR_CRASH_MEDIUM">
      <bpmndi:BPMNShape id="Start_Emergency_Response_Plan_di" bpmnElement="Start_Emergency_Response_Plan">
        <dc:Bounds x="150" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="131" y="275" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Init_Split_di" bpmnElement="Gateway_Init_Split">
        <dc:Bounds x="250" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_PoliceIntervention_di" bpmnElement="Call_PoliceIntervention">
        <dc:Bounds x="350" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_FireSuppression_di" bpmnElement="Call_FireSuppression">
        <dc:Bounds x="350" y="320" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Init_Join_di" bpmnElement="Gateway_Init_Join">
        <dc:Bounds x="550" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Emergency_Context_di" bpmnElement="Gateway_Emergency_Context" isMarkerVisible="true">
        <dc:Bounds x="650" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="643" y="285" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Ambulance_di" bpmnElement="Call_Ambulance">
        <dc:Bounds x="800" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Emergency_Response_di" bpmnElement="End_Emergency_Response">
        <dc:Bounds x="1000" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="982" y="275" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- EDGES -->
      <bpmndi:BPMNEdge id="Flow_Start_di" bpmnElement="Flow_Start">
        <di:waypoint x="186" y="250" />
        <di:waypoint x="250" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Police_di" bpmnElement="Flow_To_Police">
        <di:waypoint x="275" y="225" />
        <di:waypoint x="275" y="140" />
        <di:waypoint x="350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Fire_di" bpmnElement="Flow_To_Fire">
        <di:waypoint x="275" y="275" />
        <di:waypoint x="275" y="360" />
        <di:waypoint x="350" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_From_Police_di" bpmnElement="Flow_From_Police">
        <di:waypoint x="500" y="140" />
        <di:waypoint x="575" y="140" />
        <di:waypoint x="575" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_From_Fire_di" bpmnElement="Flow_From_Fire">
        <di:waypoint x="500" y="360" />
        <di:waypoint x="575" y="360" />
        <di:waypoint x="575" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Context_di" bpmnElement="Flow_To_Context">
        <di:waypoint x="600" y="250" />
        <di:waypoint x="650" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Injured_di" bpmnElement="Flow_Injured">
        <di:waypoint x="675" y="225" />
        <di:waypoint x="675" y="140" />
        <di:waypoint x="800" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="690" y="123" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Safe_di" bpmnElement="Flow_Safe">
        <di:waypoint x="700" y="250" />
        <di:waypoint x="1000" y="250" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="822" y="232" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_From_Ambulance_di" bpmnElement="Flow_From_Ambulance">
        <di:waypoint x="950" y="140" />
        <di:waypoint x="1018" y="140" />
        <di:waypoint x="1018" y="232" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>