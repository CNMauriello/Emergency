apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: emergency-ingress
  namespace: assd-orchestration
spec:
  ingressClassName: nginx
  rules:
    - http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: gateway-service
                port:
                  number: 8090
          - path: /
            pathType: Prefix
            backend:
              service:
                name: emergency-ui
                port:
                  number: 5173
