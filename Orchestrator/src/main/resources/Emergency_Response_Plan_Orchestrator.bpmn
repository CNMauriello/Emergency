<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Emergency" targetNamespace="http://unisannio.com/emergency" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:message id="Message_Emergency_Report" name="Emergency_Report" />
  <bpmn:message id="Message_Firefighter_Response" name="Firefighter_Response" />
  <bpmn:message id="Message_Evacuation_Response" name="Evacuation_Response" />
  <bpmn:process id="Emergency_Response_Plan_Orchestrator" name="Emergency Response Plan Orchestrator" isExecutable="true">
    <bpmn:serviceTask id="Task_Event_Analysis" name="Event Analysis">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="event-analysis" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Analysis</bpmn:incoming>
      <bpmn:outgoing>Flow_Analysis_Capability</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Plan_Selection" name="Plan Selection">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_Analysis_Capability</bpmn:incoming>
      <bpmn:outgoing>Flow_Flood_Plan</bpmn:outgoing>
      <bpmn:outgoing>Flow_City_Fire</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Flood_Plan" name="Flood" sourceRef="Gateway_Plan_Selection" targetRef="Call_Flood_Response">
      <bpmn:documentation>event.emergency_category = "FLOOD"</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=emergency_plan = "FLOOD"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="End_Emergency_Response" name="Emergency Response Completed">
      <bpmn:incoming>Flow_1l5tvwy</bpmn:incoming>
      <bpmn:incoming>Flow_0xyss1m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Analysis" sourceRef="Start_Emergency_Report" targetRef="Task_Event_Analysis" />
    <bpmn:sequenceFlow id="Flow_Analysis_Capability" sourceRef="Task_Event_Analysis" targetRef="Gateway_Plan_Selection" />
    <bpmn:callActivity id="Call_Flood_Response" name="Flood Response">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Capability_Provider&#34;" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;FLOOD_RESPONSE&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Flood_Plan</bpmn:incoming>
      <bpmn:outgoing>Flow_1l5tvwy</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Fire_Response" name="Fire Response" calledElement="Process_0t95rly">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=&#34;Emergency_Response_Plan&#34;" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;CrowdControl&#34;" target="requiredCapability" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0yz1u8k</bpmn:incoming>
      <bpmn:outgoing>Flow_1yl8myv</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1l5tvwy" sourceRef="Call_Flood_Response" targetRef="End_Emergency_Response" />
    <bpmn:sequenceFlow id="Flow_City_Fire" name="City Fire" sourceRef="Gateway_Plan_Selection" targetRef="Activity_1h18s2o">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=emergency_plan = "FIRE_LOW"
or emergency_plan = "FIRE_STANDARD"
or emergency_plan = "FIRE_HIGH"
or emergency_plan = "FIRE_CRITICAL"
</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1yl8myv" sourceRef="Call_Fire_Response" targetRef="Activity_0t30rf7" />
    <bpmn:serviceTask id="Activity_1h18s2o" name="Managing of emergency" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;http://localhost:8084/api/emergencies/&#34; + string(event_id) + &#34;/status&#34;" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#10;  status: &#34;IN_PROGRESS&#34;,&#10;  workflowInstanceId: string(processInstanceKey)&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="updated" />
          <zeebe:header key="resultExpression" value="={&#10;  updated: response.status = 200&#10;}" />
          <zeebe:header key="errorExpression" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_City_Fire</bpmn:incoming>
      <bpmn:incoming>Flow_0j34a8g</bpmn:incoming>
      <bpmn:outgoing>Flow_1l74lvf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1l74lvf" name="status updated" sourceRef="Activity_1h18s2o" targetRef="Gateway_1s8t0uu" />
    <bpmn:serviceTask id="Activity_0t30rf7" name="Emergency closed" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="15" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;http://localhost:8084/api/emergencies/&#34; + string(event_id) + &#34;/status&#34;" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#10;  status: &#34;CLOSED&#34;,&#10;  workflowInstanceId: string(processInstanceKey)&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="15" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="updated" />
          <zeebe:header key="resultExpression" value="={&#10;  updated: response.status = 200&#10;}" />
          <zeebe:header key="errorExpression" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yl8myv</bpmn:incoming>
      <bpmn:incoming>Flow_0ih3mpf</bpmn:incoming>
      <bpmn:outgoing>Flow_0su7qkr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0su7qkr" name="status updated" sourceRef="Activity_0t30rf7" targetRef="Gateway_1lb5p3v" />
    <bpmn:exclusiveGateway id="Gateway_1s8t0uu" default="Flow_0yz1u8k">
      <bpmn:incoming>Flow_1l74lvf</bpmn:incoming>
      <bpmn:outgoing>Flow_0yz1u8k</bpmn:outgoing>
      <bpmn:outgoing>Flow_0j34a8g</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0yz1u8k" sourceRef="Gateway_1s8t0uu" targetRef="Call_Fire_Response" />
    <bpmn:sequenceFlow id="Flow_0j34a8g" name="status not updated" sourceRef="Gateway_1s8t0uu" targetRef="Activity_1h18s2o">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(updated)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1lb5p3v" default="Flow_0xyss1m">
      <bpmn:incoming>Flow_0su7qkr</bpmn:incoming>
      <bpmn:outgoing>Flow_0xyss1m</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ih3mpf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0xyss1m" sourceRef="Gateway_1lb5p3v" targetRef="End_Emergency_Response" />
    <bpmn:sequenceFlow id="Flow_0ih3mpf" name="status not updated" sourceRef="Gateway_1lb5p3v" targetRef="Activity_0t30rf7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(updated)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:startEvent id="Start_Emergency_Report" name="Emergency Report">
      <bpmn:outgoing>Flow_Start_Analysis</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:textAnnotation id="TextAnnotation_0m6rs9a">
      <bpmn:text>Chiama il BPMN binder e come input mapping (parametri che gli passo stile funzione) gli ho dato una capability hard coded in camunda perchè questo è come se fosse il BPMN caricato dal gestore workflow. Chi scrive il piano quindi può decidere le capability sulla base dei flag presenti nel JSON.
Prima passavo come input mapping anche latitudine e longitudine leggendole dal JSON ricevuto, ma a quanto pare il figlio eredita le varibili camunda del BPMN padre e le ho tolte.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0za0txh" associationDirection="None" sourceRef="Call_Fire_Response" targetRef="TextAnnotation_0m6rs9a" />
    <bpmn:textAnnotation id="TextAnnotation_1skfl33">
      <bpmn:text>Bisogna avvisare il gestore emergenze tramite task che l'emergenza è terminata oppure andando a sprecficare l'api/metadati di camunda</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1dhh0x2" associationDirection="None" sourceRef="End_Emergency_Response" targetRef="TextAnnotation_1skfl33" />
  </bpmn:process>
